@* 
    <!-- ==================== 11 & 12. ADD / EDIT EXPERIENCE MODAL ==================== -->
    <div class="modal fade" id="experienceFormModal" tabindex="-1" aria-labelledby="experienceModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <form id="experienceForm" novalidate>
                    <input type="hidden" id="formExperienceId" value="">

                    <div class="modal-header">
                        <div>
                            <h5 class="modal-title fw-bold" id="experienceModalTitle">Yeni Deneyim Ekle</h5>
                            <small class="text-secondary" id="experienceModalSubtitle">Profesyonel geçmişinize yeni bir deneyim ekleyin.</small>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                    </div>

                    <div class="modal-body">
                        <div class="row g-3">
                            <!-- 1. Pozisyon Adı -->
                            <div class="col-12 col-md-6">
                                <label for="inputPosition" class="form-label">Pozisyon Adı <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="inputPosition" placeholder="Örn: Senior Software Engineer" required>
                                <div class="invalid-feedback">Lütfen pozisyon adını giriniz.</div>
                            </div>

                            <!-- 2. Şirket Adı -->
                            <div class="col-12 col-md-6">
                                <label for="inputCompany" class="form-label">Şirket Adı <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="inputCompany" placeholder="Örn: NovaTech Solutions" required>
                                <div class="invalid-feedback">Lütfen şirket adını giriniz.</div>
                            </div>

                            <!-- 3. Çalışma Türü -->
                            <div class="col-12 col-md-6">
                                <label for="inputEmploymentType" class="form-label">Çalışma Türü <span class="text-danger">*</span></label>
                                <select class="form-select" id="inputEmploymentType" required>
                                    <option value="" disabled selected>Seçiniz...</option>
                                    <option value="Tam Zamanlı">Tam Zamanlı</option>
                                    <option value="Yarı Zamanlı">Yarı Zamanlı</option>
                                    <option value="Staj">Staj</option>
                                    <option value="Sözleşmeli">Sözleşmeli</option>
                                </select>
                                <div class="invalid-feedback">Lütfen bir çalışma türü seçiniz.</div>
                            </div>

                            <!-- 4. Çalışma Konumu -->
                            <div class="col-12 col-md-6">
                                <label for="inputLocation" class="form-label">Çalışma Konumu</label>
                                <input type="text" class="form-control" id="inputLocation" placeholder="Örn: İstanbul / Hibrit">
                            </div>

                            <!-- 5. Başlangıç Tarihi -->
                            <div class="col-12 col-md-6">
                                <label for="inputStartDate" class="form-label">Başlangıç Tarihi <span class="text-danger">*</span></label>
                                <input type="month" class="form-control" id="inputStartDate" required>
                                <div class="invalid-feedback">Lütfen geçerli bir başlangıç tarihi seçiniz.</div>
                            </div>

                            <!-- 6. Bitiş Tarihi -->
                            <div class="col-12 col-md-6">
                                <label for="inputEndDate" class="form-label">Bitiş Tarihi</label>
                                <input type="month" class="form-control" id="inputEndDate">
                                <div class="invalid-feedback" id="endDateFeedback">Bitiş tarihi başlangıç tarihinden önce olamaz.</div>
                            </div>

                            <!-- 7. Halen Burada Çalışıyorum Checkbox -->
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="inputIsCurrent">
                                    <label class="form-check-label fw-medium text-dark" for="inputIsCurrent" style="font-size: 0.85rem;">
                                        Halen burada çalışıyorum (Aktif Pozisyon)
                                    </label>
                                </div>
                            </div>

                            <!-- 8. Deneyim Açıklaması -->
                            <div class="col-12">
                                <label for="inputDescription" class="form-label">Deneyim Açıklaması</label>
                                <textarea class="form-control" id="inputDescription" rows="3" placeholder="Bu pozisyondaki görevlerinizi ve sorumluluklarınızı açıklayın..."></textarea>
                            </div>

                            <!-- 9. Kullanılan Teknolojiler -->
                            <div class="col-12">
                                <label for="inputTechnologies" class="form-label">Kullanılan Teknolojiler (Virgülle ayırın)</label>
                                <input type="text" class="form-control" id="inputTechnologies" placeholder="Örn: C#, ASP.NET Core, SQL Server, Docker">
                                <small class="text-muted" style="font-size: 0.75rem;">Virgülle ayırarak yazdığınız teknolojiler otomatik rozet olarak eklenecektir.</small>
                                <div class="tags-preview-container" id="modalTagsPreview"></div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-pastel-outline" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn-pastel-primary" id="btnSubmitExperience">
                            <i class="bi bi-check2"></i>
                            <span id="btnSubmitText">Deneyimi Kaydet</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ==================== 13. DELETE EXPERIENCE CONFIRMATION MODAL ==================== -->
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm" style="max-width: 420px;">
            <div class="modal-content">
                <div class="modal-body text-center p-4">
                    <div class="mb-3">
                        <div class="d-inline-flex p-3 rounded-circle" style="background-color: var(--soft-red); color: var(--soft-red-text); font-size: 1.8rem;">
                            <i class="bi bi-trash3-fill"></i>
                        </div>
                    </div>
                    <h5 class="fw-bold mb-2" id="deleteModalTitle">Deneyimi Silmek İstiyor musunuz?</h5>
                    <p class="text-secondary mb-3" style="font-size: 0.85rem;">
                        Seçtiğiniz deneyim kaydı listeden kaldırılacaktır. Bu işlemi geri alamazsınız.
                    </p>

                    <div class="p-3 rounded-3 text-start mb-3" style="background-color: #F8F9FD; border: 1px dashed var(--border-color);">
                        <div class="fw-bold text-dark" id="deleteTargetPosition" style="font-size: 0.9rem;">-</div>
                        <div class="text-secondary small" id="deleteTargetCompany">-</div>
                    </div>

                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-pastel-outline px-3" data-bs-dismiss="modal">Vazgeç</button>
                        <button type="button" class="btn btn-danger px-4 rounded-3 fw-semibold" id="confirmDeleteBtn" style="background-color: #e54848; border-color: #e54848;">
                            Evet, Sil
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== 14. VIEW DETAILS MODAL ==================== -->
    <div class="modal fade" id="viewDetailsModal" tabindex="-1" aria-labelledby="viewDetailsModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="company-avatar" id="viewAvatarText" style="width: 44px; height: 44px; font-size: 1.1rem;">N</div>
                        <div>
                            <h5 class="modal-title fw-bold" id="viewDetailsModalTitle">Deneyim Detayları</h5>
                            <small class="text-secondary" id="viewHeaderSubtitle">Pozisyon ve kurum ayrıntıları</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="row g-4">
                        <div class="col-12 col-md-7">
                            <h4 class="fw-bold text-dark mb-1" id="viewPositionTitle">Senior Software Engineer</h4>
                            <div class="text-secondary fw-semibold fs-6 mb-3" id="viewCompanyName">NovaTech Solutions</div>

                            <div class="mb-3">
                                <span class="text-uppercase fw-bold text-muted d-block mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Açıklama</span>
                                <p class="text-secondary" id="viewDescriptionText" style="font-size: 0.88rem; line-height: 1.6;">-</p>
                            </div>

                            <div>
                                <span class="text-uppercase fw-bold text-muted d-block mb-2" style="font-size: 0.7rem; letter-spacing: 0.05em;">Kullanılan Teknolojiler</span>
                                <div class="d-flex flex-wrap gap-1" id="viewTechnologiesList"></div>
                            </div>
                        </div>

                        <div class="col-12 col-md-5">
                            <div class="p-3 rounded-3" style="background-color: #F8F9FD; border: 1px solid var(--border-color);">
                                <div class="mb-3">
                                    <span class="text-muted d-block" style="font-size: 0.72rem;">Çalışma Durumu</span>
                                    <div id="viewStatusBadge" class="mt-1"></div>
                                </div>

                                <div class="mb-3">
                                    <span class="text-muted d-block" style="font-size: 0.72rem;">Çalışma Türü</span>
                                    <div class="fw-semibold text-dark mt-1" id="viewEmploymentType" style="font-size: 0.85rem;">-</div>
                                </div>

                                <div class="mb-3">
                                    <span class="text-muted d-block" style="font-size: 0.72rem;">Konum</span>
                                    <div class="fw-semibold text-dark mt-1" id="viewLocation" style="font-size: 0.85rem;">-</div>
                                </div>

                                <div class="mb-1">
                                    <span class="text-muted d-block" style="font-size: 0.72rem;">Tarih Aralığı</span>
                                    <div class="fw-semibold text-dark mt-1" id="viewDateRange" style="font-size: 0.85rem;">-</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-pastel-outline" data-bs-dismiss="modal">Kapat</button>
                    <button type="button" class="btn-pastel-primary" id="viewEditTriggerBtn">
                        <i class="bi bi-pencil-square"></i>
                        <span>Deneyimi Düzenle</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== 16. TOAST CONTAINER ==================== -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="top: 80px !important;">
        <div id="appToast" class="toast custom-toast align-items-center" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000">
            <div class="d-flex align-items-center p-2">
                <div id="toastIconWrap" class="p-2 rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                    <i id="toastIcon" class="bi bi-check2"></i>
                </div>
                <div class="toast-body flex-grow-1 p-0 fw-medium text-dark" id="toastMessage">
                    İşlem başarıyla tamamlandı.
                </div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
            </div>
        </div>
    </div>
 *@

